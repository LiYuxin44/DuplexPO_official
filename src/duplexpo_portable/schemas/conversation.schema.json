{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duplexpo.dev/schemas/conversation.v1.json",
  "title": "DuplexPO canonical conversation v1",
  "type": "object",
  "required": ["schema_version", "conversation_id", "duration_s", "units"],
  "properties": {
    "schema_version": {"const": "duplexpo.v1"},
    "conversation_id": {"type": "string", "minLength": 1},
    "duration_s": {"type": "number", "exclusiveMinimum": 0},
    "source": {"type": "string"},
    "split": {"type": ["string", "null"]},
    "granularity": {"enum": ["word", "utterance"]},
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["speaker", "start_s", "end_s", "text"],
        "properties": {
          "speaker": {"enum": ["user", "agent"]},
          "start_s": {"type": "number", "minimum": 0},
          "end_s": {"type": "number", "exclusiveMinimum": 0},
          "text": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
