{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duplexpo.dev/schemas/recipe.v1.json",
  "title": "DuplexPO paper recipe v1",
  "type": "object",
  "required": ["schema_version", "recipe_id", "paper", "protocol_version", "construction", "windows", "rollout", "reward", "grpo"],
  "properties": {
    "schema_version": {"const": "duplexpo.recipe.v1"},
    "recipe_id": {"type": "string", "minLength": 1},
    "paper": {"type": "string", "format": "uri"},
    "protocol_version": {"const": "duplexpo.v1"},
    "construction": {"type": "object"},
    "windows": {"type": "object"},
    "rollout": {"type": "object"},
    "reward": {"type": "object"},
    "grpo": {"type": "object"},
    "optimizer": {"type": "object"},
    "training": {"type": "object"}
  },
  "additionalProperties": false
}
